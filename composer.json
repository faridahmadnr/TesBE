{
    "name": "kahasolusi/kurjogja",
    "type": "project",
    "description": "",
    "keywords": [
        "kur",
        "kahasolusi"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "dedoc/scramble": "^0.8.6",
        "deligoez/laravel-model-hashid": "dev-main",
        "deployer/deployer": "^7.3",
        "divineomega/laravel-password-exposed-validation-rule": "dev-l10-compatibility",
        "doctrine/dbal": "^3.8",
        "elegantweb/sanitizer": "^2.1",
        "erlandmuchasaj/laravel-gzip": "^1.1",
        "guzzlehttp/guzzle": "^7.2",
        "http-interop/http-factory-guzzle": "^1.2",
        "langleyfoxall/laravel-nist-password-rules": "dev-l10-compatibility",
        "laravel/breeze": "^1.25",
        "laravel/framework": "^10.10",
        "laravel/pennant": "^1.5",
        "laravel/sanctum": "^3.2",
        "laravel/scout": "^10.5",
        "laravel/tinker": "^2.8",
        "league/flysystem-aws-s3-v3": "^3.16",
        "league/flysystem-path-prefixing": "^3.16",
        "league/flysystem-read-only": "^3.16",
        "meilisearch/meilisearch-php": "^1.4",
        "mews/purifier": "^3.4",
        "nwidart/laravel-modules": "^10.0",
        "predis/predis": "^2.2",
        "propaganistas/laravel-disposable-email": "^2.2",
        "propaganistas/laravel-phone": "^5.0",
        "rennokki/laravel-eloquent-query-cache": "^3.4",
        "richan-fongdasen/eloquent-blameable": "^1.9",
        "sentry/sentry-laravel": "^4.6",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-backup": "^9.0",
        "spatie/laravel-permission": "^6.0",
        "spatie/laravel-query-builder": "^5.6",
        "spatie/simple-excel": "^3.6",
        "vercoutere/laravel-mjml": "dev-master"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.13",
        "fakerphp/faker": "^1.9.1",
        "jedymatt/laravel-sail-env": "^1.1",
        "larastan/larastan": "^2.9.5",
        "laravel/envoy": "^2.8",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^7.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-faker": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "spatie/laravel-ignition": "^2.0",
        "sti3bas/laravel-scout-array-driver": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "clear-all": [
            "@php artisan clear-compiled",
            "@php artisan cache:clear",
            "@php artisan route:clear",
            "@php artisan view:clear",
            "@php artisan config:clear",
            "composer dumpautoload -o"
        ],
        "cache-all": [
            "@php artisan config:cache",
            "@php artisan route:cache"
        ],
        "generate-helper": [
            "@php artisan ide-helper:models"
        ],
        "reset": [
            "composer clear-all",
            "composer cache-all"
        ],
        "sync-scout": [
            "@php artisan scout:sync-index-settings"
        ],
        "test": "./vendor/bin/pest --coverage-html coverage",
        "test-coverage": "vendor/bin/pest --parallel --coverage-html coverage",
        "format": "vendor/bin/pint",
        "lint": "./vendor/bin/phpstan analyse --memory-limit=2G"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "patches": {
            "deligoez/laravel-model-hashid": {
                "Change return to throw": "./patches"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laravel-shift/laravel-password-exposed-validation-rule.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/agungkes/laravel-nist-password-rules.git"
        },
        {
            "type": "git",
            "url": "https://github.com/agungkes/laravel-model-hashid.git"
        },
        {
            "type": "git",
            "url": "https://github.com/Kaha-Tech/laravel-mjml.git"
        }
    ]
}
